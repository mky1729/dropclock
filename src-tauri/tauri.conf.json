{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drop Clock Tauri",
  "version": "1.0.1",
  "identifier": "com.dropclock.tauri",
  "build": {
    "beforeDevCommand": "npm run tauri:prepare",
    "beforeBuildCommand": "npm run tauri:prepare",
    "frontendDist": "../.tauri-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drop Clock Tauri",
        "width": 520,
        "height": 780,
        "minWidth": 420,
        "minHeight": 620,
        "backgroundColor": "#e0c3fc"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../files/favicon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "../files/favicon.ico"
      }
    }
  }
}
